{
  "jupyter.lab.shortcuts": [],
  "title": "ExploratoryJupyterExtension",
  "description": "ExploratoryJupyterExtension settings.",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "jupyter.lab.toolbars": {
    "Cell": [
      {
        "name": "add",
        "command": "alternative-command-add",
        "rank": 10
      },
      {
        "name": "left",
        "command": "alternative-command-left",
        "rank": 15
      },
      {
        "name": "right",
        "command": "alternative-command-right",
        "rank": 20
      },
      {
        "name": "delete",
        "command": "alternative-command-delete",
        "rank": 25
      },
      {
        "name": "expand",
        "command": "collapsed-command-expand",
        "rank": 30
      },
      {
        "name": "collapse",
        "command": "collapsed-command-collapse",
        "rank": 35
      },
      {
        "name": "open-new-tab",
        "command": "collapsed-command-open-new-tab",
        "rank": 40
      }
    ]
  },
  "jupyter.lab.metadataforms": [
    {
      "id": "alternatives-data",
      "label": "Alternative Versions",
      "metadataSchema": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Alternative Versions",
            "description": "List of alternative code versions"
          },
          "activeVersion": {
            "type": "integer",
            "title": "Active Version",
            "description": "Index of currently active version",
            "minimum": 0
          }
        }
      }
    },
    {
      "id": "collapsed-data",
      "label": "Collapsed",
      "metadataSchema": {
        "type": "object",
        "properties": {
          "storedNodes": {
            "type": "array",
            "title": "Stored Nodes",
            "description": "List of nodes that were collapsed",
            "items": {
              "type": "object",
              "properties": {
                "cellId": {
                  "type": "string",
                  "description": "ID of the collapsed cell"
                },
                "source": {
                  "type": "string",
                  "description": "Source code of the collapsed cell"
                },
                "alternativeMetadata": {
                  "type": "object",
                  "description": "Alternative metadata of the collapsed cell"
                },
                "nestedNodes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/jupyter.lab.metadataforms/1/metadataSchema/properties/storedNodes/items"
                  },
                  "description": "Nodes that were collapsed within this node"
                }
              },
              "required": ["cellId"]
            }
          }
        }
      }
    }
  ]
}
